# ========================================================
# ENVIRONMENT: PROD (Production Cluster - High Availability)
# ========================================================
NODE_ENV=production
APP_ENV=prod

# Hub & Spoke Ports
PORT=8000
DOMAIN_SERVICE_PORT=8000
BOOKING_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8001
SEARCH_SERVICE_PORT=8002
AUTH_SERVICE_PORT=8003
VIDEO_SERVICE_PORT=8005
CONFIG_SERVICE_PORT=8006
WEB_PORT=3000

# Production Internal K8s DNS Service URLs
DOMAIN_SERVICE_URL=http://domain-service.cohort-prod.svc.cluster.local:8000/graphql
BOOKING_SERVICE_URL=http://booking-service.cohort-prod.svc.cluster.local:8004/graphql
NOTIFICATION_SERVICE_URL=http://notification-service.cohort-prod.svc.cluster.local:8001/graphql
SEARCH_SERVICE_URL=http://search-service.cohort-prod.svc.cluster.local:8002/graphql
AUTH_SERVICE_URL=http://auth-service.cohort-prod.svc.cluster.local:8003/graphql
VIDEO_SERVICE_URL=http://video-service.cohort-prod.svc.cluster.local:8005/graphql
CONFIG_SERVICE_URL=http://config-hub.cohort-prod.svc.cluster.local:8006/graphql
WEB_URL=https://cohort.io

# Database & Persistent Storage (Cloud SQL / Managed RDS / HA StatefulSet)
DATABASE_URL=postgresql://prod_app_user:prod_super_secret_pwd@prod-postgres.cohort-prod.svc.cluster.local:5432/cohort_prod
STORAGE_DIR=/var/data/cohort/prod/storage

# Temporal HA Engine
TEMPORAL_ADDRESS=temporal.cohort-prod.svc.cluster.local:7233
TEMPORAL_NAMESPACE=prod-default

# Logging & Strict Security
LOG_LEVEL=warn
CORS_ORIGIN=https://cohort.io,https://app.cohort.io
