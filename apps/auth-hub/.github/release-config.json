{
  "group-pull-request-title-pattern": "chore${scope}: release",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "auth-hub",
      "component": "auth-hub",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "helm/values.yaml"
        },
        {
          "type": "generic",
          "path": "helm/Chart.yaml"
        }
      ]
    }
  }
}
