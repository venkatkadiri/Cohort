# ========================================================
# ENVIRONMENT: STAGE (Pre-Production Staging Cluster)
# ========================================================
NODE_ENV=production
APP_ENV=stage

# Hub & Spoke Ports
PORT=8000
DOMAIN_SERVICE_PORT=8000
BOOKING_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8001
SEARCH_SERVICE_PORT=8002
AUTH_SERVICE_PORT=8003
VIDEO_SERVICE_PORT=8005
CONFIG_SERVICE_PORT=8006
WEB_PORT=3000

# Staging Internal K8s DNS Service URLs
DOMAIN_SERVICE_URL=http://stage-domain-service.cohort-stage.svc.cluster.local:8000/graphql
BOOKING_SERVICE_URL=http://stage-booking-service.cohort-stage.svc.cluster.local:8004/graphql
NOTIFICATION_SERVICE_URL=http://stage-notification-service.cohort-stage.svc.cluster.local:8001/graphql
SEARCH_SERVICE_URL=http://stage-search-service.cohort-stage.svc.cluster.local:8002/graphql
AUTH_SERVICE_URL=http://stage-auth-service.cohort-stage.svc.cluster.local:8003/graphql
VIDEO_SERVICE_URL=http://stage-video-service.cohort-stage.svc.cluster.local:8005/graphql
CONFIG_SERVICE_URL=http://stage-config-hub.cohort-stage.svc.cluster.local:8006/graphql
WEB_URL=https://stage.cohort.io

# Database & Storage
DATABASE_URL=postgresql://stage_user:stage_secret_pwd@stage-postgres.cohort-stage.svc.cluster.local:5432/cohort_stage
STORAGE_DIR=/var/data/cohort/stage/storage

# Temporal
TEMPORAL_ADDRESS=stage-temporal.cohort-stage.svc.cluster.local:7233
TEMPORAL_NAMESPACE=stage-default

# Logging & Security
LOG_LEVEL=info
CORS_ORIGIN=https://stage.cohort.io,https://stage-admin.cohort.io
