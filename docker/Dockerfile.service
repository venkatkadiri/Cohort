# Multi-Stage Dockerfile for Backend Microservices
# Build Argument: SERVICE_NAME (e.g. domain-service, booking-service, video-service, configuration-hub)
ARG SERVICE_NAME=domain-service

# 1. Base dependencies stage
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.5.0 --activate
WORKDIR /app
RUN apk add --no-cache libc6-compat ffmpeg

# 2. Dependencies & Build stage
FROM base AS builder
ARG SERVICE_NAME
WORKDIR /app

# Copy root manifest files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./

# Copy shared observability and service source
COPY observability ./observability
COPY hubs/${SERVICE_NAME} ./hubs/${SERVICE_NAME}

# Install dependencies and build
RUN pnpm --filter @cohort/${SERVICE_NAME}... install --frozen-lockfile
RUN pnpm --filter @cohort/${SERVICE_NAME}... build

# 3. Production runner stage
FROM node:22-alpine AS runner
ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENV NODE_ENV=production
RUN apk add --no-cache ffmpeg

WORKDIR /app

# Run as non-root user for production security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs

COPY --from=builder --chown=nodejs:nodejs /app/hubs/${SERVICE_NAME}/package.json ./package.json
COPY --from=builder --chown=nodejs:nodejs /app/hubs/${SERVICE_NAME}/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/hubs/${SERVICE_NAME}/node_modules ./hubs/${SERVICE_NAME}/node_modules

USER nodejs

EXPOSE 8000 8001 8002 8003 8004 8005 8006
CMD ["node", "dist/index.js"]
