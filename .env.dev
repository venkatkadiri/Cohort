# ========================================================
# ENVIRONMENT: DEV (Local / Development Cluster)
# ========================================================
NODE_ENV=development
APP_ENV=dev

# Hub & Spoke Microservices (Port Mapping)
PORT=8000
DOMAIN_SERVICE_PORT=8000
BOOKING_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8001
SEARCH_SERVICE_PORT=8002
AUTH_SERVICE_PORT=8003
VIDEO_SERVICE_PORT=8005
CONFIG_SERVICE_PORT=8006
WEB_PORT=3000

# Service URLs (Local / Cluster Dev)
DOMAIN_SERVICE_URL=http://localhost:8000/graphql
BOOKING_SERVICE_URL=http://localhost:8004/graphql
NOTIFICATION_SERVICE_URL=http://localhost:8001/graphql
SEARCH_SERVICE_URL=http://localhost:8002/graphql
AUTH_SERVICE_URL=http://localhost:8003/graphql
VIDEO_SERVICE_URL=http://localhost:8005/graphql
CONFIG_SERVICE_URL=http://localhost:8006/graphql
WEB_URL=http://localhost:3000

# Database & Storage
DATABASE_URL=postgresql://temporal:temporal@localhost:5433/temporal
STORAGE_DIR=./storage/dev

# Temporal Workflows
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Logging & Debugging
LOG_LEVEL=debug
CORS_ORIGIN=*
