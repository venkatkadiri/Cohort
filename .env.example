# Copy this file to .env and edit values as needed.
# If you use the included docker-compose for Temporal+Postgres, the example DATABASE_URL
# below assumes the Postgres container is exposed on host port 5433 to avoid conflicts
# with any locally running Postgres on 5432. If you mapped to 5432, update accordingly.

# PostgreSQL connection string for Prisma. Example for docker-compose mapped to 5433:
DATABASE_URL="postgresql://temporal:temporal@localhost:5433/temporal"

# Number of days to generate slots for (used by regenerateHostSlots)
SLOT_GENERATION_DAYS=30

# SMTP (optional) — configure if you want email notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Google service account (optional) — configure to enable Calendar/Meet integration
# For GOOGLE_PRIVATE_KEY, preserve newlines as '\n' sequences when placing in .env
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Better-auth configuration (enable real provider auth by setting BETTER_AUTH_ENABLED=1)
BETTER_AUTH_ENABLED=0
BETTER_AUTH_PROVIDER=github
BETTER_AUTH_CLIENT_ID=your-client-id
BETTER_AUTH_CLIENT_SECRET=your-client-secret
BETTER_AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
BETTER_AUTH_SIGNOUT_URL=
